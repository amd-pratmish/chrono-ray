export CHRONO_PYTHON_DIR="${CHRONO_PYTHON_DIR:-${CHRONO_HIP_PREFIX}/share/chrono/python}"
export AMD_CHRONOS_ROOT="${AMD_CHRONOS_ROOT:-/shared/${USER}/amd-chronos}"
